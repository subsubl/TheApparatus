[Unit]
Description=The Apparatus - Pi B Master Player (L2/L3 autoloader)
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=pi
Environment=APPARATUS_LAYER3_START_S=300
ExecStart=/usr/bin/python3 /home/pi/apparatus/player_b.py
Restart=always
RestartSec=3

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal

SupplementaryGroups=video render input tty

[Install]
WantedBy=multi-user.target