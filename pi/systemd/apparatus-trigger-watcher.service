[Unit]
Description=The Apparatus - Pi B mpv Serial Daemon (LOOP_A/LOOP_B/TRIGGER_SEEK)
BindsTo=apparatus-player-b.service
After=apparatus-player-b.service
Requires=apparatus-player-b.service

[Service]
Type=simple
User=pi
Environment=APPARATUS_SERIAL=/dev/serial0
Environment=APPARATUS_MPV_SOCKET=/tmp/apparatus-mpv.sock
ExecStart=/usr/bin/python3 /home/pi/apparatus/mpv_daemon.py
Restart=always
RestartSec=3

# dialout for /dev/serial0, video/render for IPC-adjacent ops
SupplementaryGroups=dialout video render

[Install]
WantedBy=graphical.target